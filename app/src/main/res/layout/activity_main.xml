<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center_horizontal"
 android:padding="24dp" android:background="#111111">
 <Space android:layout_width="1dp" android:layout_height="50dp"/>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:text="OPAL • POZIOM" android:textColor="#AAAAAA" android:textSize="15sp"/>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:text="odchylenie od pionu" android:textColor="#888888" android:textSize="14sp"/>
 <TextView android:id="@+id/angle" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:gravity="center" android:text="0,0°" android:textColor="#FFFFFF"
  android:textSize="72sp" android:textStyle="bold" android:fontFamily="monospace"
  android:layout_marginTop="40dp"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:gravity="center" android:text="Przyłóż długi bok telefonu do mierzonej powierzchni"
  android:textColor="#AAAAAA" android:textSize="15sp" android:layout_marginTop="16dp"/>
 <Button android:id="@+id/zeroButton" android:layout_width="match_parent" android:layout_height="60dp"
  android:text="Wyzeruj" android:textSize="18sp" android:layout_marginTop="48dp"/>
 <Button android:id="@+id/resetButton" android:layout_width="match_parent" android:layout_height="54dp"
  android:text="Usuń zerowanie" android:textSize="15sp" android:layout_marginTop="12dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:gravity="center" android:text="0,0° = idealny pion"
  android:textColor="#777777" android:textSize="13sp" android:layout_marginTop="24dp"/>
</LinearLayout>
